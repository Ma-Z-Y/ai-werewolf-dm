# Local LLM server — copy to `.env` and edit. Read by the game (the 「本地 LLM」
# entry in 配置: its address and model list come only from here and cannot be
# edited in the game), the dev-server proxy, tools/llm_selfplay.ts and
# tools/mtplx_round_bench.py. After editing, refresh the page. OpenAI / DeepSeek are configured in the game
# (配置 → AI 引擎); their keys are stored encrypted in the browser, not here.

# OpenAI-compatible endpoint, including the port (local MTPLX by default).
# The only local address the game uses.
LLM_BASE_URL=http://127.0.0.1:8001/v1
# Models the game offers in its picker, comma-separated, ids as listed by
# GET /v1/models. The first one is the default (and what the tools use).
# (Older .env files with a single LLM_MODEL=… still work.)
LLM_MODELS=mtplx-qwen38-27b-optimized-speed
# Optional. Stays on the dev server: the proxy adds `Authorization: Bearer …`;
# it is never bundled into the browser code.
LLM_API_KEY=

# none | low | medium | high
LLM_REASONING=medium
# votes, night skills and wolf chat (short, frequent calls)
LLM_DECISION_REASONING=low

# Route browser requests through the Vite dev server (needed for local servers that refuse CORS)
LLM_USE_PROXY=true
LLM_TIMEOUT_MS=180000
